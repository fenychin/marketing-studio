# Any OpenAI images-protocol compatible channel (aggregator or self-hosted).
# Leave empty to run with the built-in mock provider only.
STUDIO_OPENAI_BASE_URL=
STUDIO_OPENAI_API_KEY=
STUDIO_OPENAI_IMAGE_MODEL=gpt-image-1

# Async-task video channel (Seedance-class: POST /tasks → GET /tasks/:id → download).
# Leave empty to skip; use `pnpm dev:channel` to test the adapter locally.
STUDIO_VIDEO_CHANNEL_URL=
STUDIO_VIDEO_CHANNEL_KEY=
STUDIO_VIDEO_CHANNEL_MODEL=channel-video-v1

# Database: sqlite (default, dev) | postgres (embedded Postgres via PGlite;
# production uses a hosted Postgres — same SQL, see deploy/k8s).
STUDIO_DB_DRIVER=sqlite
STUDIO_PG_DATA=

# Storage: fs (default) | s3 (any S3-compatible object store)
STUDIO_STORAGE_DRIVER=fs
STUDIO_S3_BUCKET=
STUDIO_S3_REGION=us-east-1
STUDIO_S3_ACCESS_KEY_ID=
STUDIO_S3_SECRET_ACCESS_KEY=
STUDIO_S3_ENDPOINT=

# Auth / billing secrets (REQUIRED in production — defaults are dev-only)
STUDIO_JWT_SECRET=
STUDIO_PAYMENT_WEBHOOK_SECRET=

STUDIO_API_PORT=8787
STUDIO_WEB_ORIGIN=http://127.0.0.1:5273
MOCK_CHANNEL_PORT=8790

# Dev/test override: allow fetching private/loopback hosts (local fixture pages).
# NEVER enable in production.
STUDIO_ALLOW_PRIVATE_FETCH=

# Word-level ASR sidecar (services/asr-sidecar): elevates ad-reference
# replication from rate assumptions to real word timings. Start with
# `scripts/start-asr.sh`, then point the API at it.
STUDIO_ASR_URL=

# LLM copywriting channel (OpenAI chat-compatible). When absent the
# deterministic rule composer keeps the rhythm replica at 100%.
STUDIO_LLM_BASE_URL=
STUDIO_LLM_API_KEY=
STUDIO_LLM_MODEL=gpt-4o-mini

# 真实视频渠道(MiniMax H3 / Seedance 2.5):填入即出现在模型目录,
# 复刻工作流(广告参考/商品链接/模板复刻)可直接选用;留空则用 mock 引擎。
# MiniMax: POST {BASE}/video_generation → /query → /files/retrieve
STUDIO_MINIMAX_BASE_URL=
STUDIO_MINIMAX_API_KEY=
STUDIO_MINIMAX_MODEL=MiniMax-H3
# Seedance(火山方舟): POST {BASE}/contents/generations/tasks → GET 任务 → video_url
STUDIO_SEEDANCE_BASE_URL=
STUDIO_SEEDANCE_API_KEY=
STUDIO_SEEDANCE_MODEL=doubao-seedance-2-5-pro
# GPT Image 参考编辑:复用 STUDIO_OPENAI_*(有参考图自动走 /images/edits),
# 模型名可设为 gpt-image-2.5:
# STUDIO_OPENAI_IMAGE_MODEL=gpt-image-2.5
